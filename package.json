{
  "name": "kiss4da",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @kiss4da/* build",
    "dev": "pnpm --filter @kiss4da/* dev",
    "start": "pnpm --filter @kiss4da/* start",
    "typecheck": "pnpm --filter @kiss4da/* typecheck",
    "api:build": "pnpm --filter @kiss4da/api build",
    "api:deploy": "pnpm --filter @kiss4da/api deploy",
    "api:db:create": "pnpm --filter @kiss4da/api db:create",
    "api:db:migrate:local": "pnpm --filter @kiss4da/api db:migrate:local",
    "api:db:migrate:remote": "pnpm --filter @kiss4da/api db:migrate:remote",
    "api:db:exec": "pnpm --filter @kiss4da/api db:exec",
    "api:start": "pnpm --filter @kiss4da/api start",
    "api:typecheck": "pnpm --filter @kiss4da/api typecheck",
    "api:worker:dev": "pnpm --filter @kiss4da/api worker:dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "web:build": "pnpm --filter @kiss4da/web build",
    "web:dev": "pnpm --filter @kiss4da/web dev",
    "web:start": "pnpm --filter @kiss4da/web start",
    "web:typecheck": "pnpm --filter @kiss4da/web typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0"
  },
  "packageManager": "pnpm@10.15.1"
}
