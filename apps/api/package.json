{
  "name": "@kiss4da/api",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./src/app.ts",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:create": "wrangler d1 create kiss4da",
    "db:migrate:local": "wrangler d1 migrations apply kiss4da --local",
    "db:migrate:remote": "wrangler d1 migrations apply kiss4da --remote",
    "db:exec": "wrangler d1 execute kiss4da",
    "dev": "tsx watch src/server.ts",
    "deploy": "wrangler deploy",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.2"
  }
}
